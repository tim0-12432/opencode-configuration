{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "dark"
  },
  "plugins": [
    "opencode-traffic-light"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "none",
    "verbosity": "medium",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "on",
    "indicators": "status"
  },
  "terminal": {
    "copy": "manual"
  }
}
