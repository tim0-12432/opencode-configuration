{
    "$schema": "https://opencode.ai/config.json",
    "share": "disabled",
    "disabled_providers": [
        "openai",
        "zen",
        "opencode"
    ],
    "plugin": [
        //"@tarquinen/opencode-dcp@3.1.14",
        //"caveman-opencode-plugin@0.1.5"
    ],
    "instructions": [],
    "mcp": {
        "mcp-gateway": {
            "type": "local",
            "command": ["docker", "mcp", "gateway", "run"],
            "enabled": true
        },
        "playwright": {
            "type": "local",
            "command": ["npx", "@playwright/mcp@latest", "--isolated", "--browser=chrome"],
            "enabled": true
        },
        "github": {
            "type": "local",
            "command": ["docker", "run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "-e", "GITHUB_TOOLSETS", "-e", "GITHUB_READ_ONLY", "ghcr.io/github/github-mcp-server"],
            "enabled": true,
            "environment": {
                "GITHUB_PERSONAL_ACCESS_TOKEN": "<github pat>",
                "GITHUB_TOOLSETS": "default",
                "GITHUB_READ_ONLY": "1"
            }
        },
    },
    "model": "github-copilot/claude-sonnet-5",
    "small_model": "github-copilot/gpt-5.4-mini",
    "agent": {
        "explore": {
            "model": "github-copilot/claude-haiku-4.5",
            "variant": "default"
        },
        "compaction": {
            "model": "github-copilot/gpt-5.4-mini",
            "variant": "medium"
        },
        "title": {
            "model": "github-copilot/gpt-5-mini",
            "variant": "low"
        },
        "summary": {
            "model": "github-copilot/gpt-5-mini",
            "variant": "high"
        }
    }
}
